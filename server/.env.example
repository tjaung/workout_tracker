APP_NAME=Workout Tracker API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api

CLIENT_ORIGINS=http://localhost:5173

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=workout_tracker
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Optional override. In Docker Compose this points at the postgres service.
# DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/workout_tracker
